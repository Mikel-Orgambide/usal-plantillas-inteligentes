{
  "expo": {
    "name": "NSL",
    "slug": "plantillas-inteligentes",
    "version": "0.14.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mikelorgambide.plantillasinteligentes"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0c0d10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mikelorgambide.plantillasinteligentes"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "mikel-orgambide",
    "scheme": "plantillas",
    "extra": {
      "eas": {
        "projectId": "3b47649d-172b-4c2b-8ac4-1d9a13ea119c"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "react-native-ble-manager",
        {
          "isBleRequired": false,
          "neverForLocation": true,
          "companionDeviceEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c0d10",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      "expo-sharing"
    ],
    "backgroundColor": "#0c0d10"
  }
}
