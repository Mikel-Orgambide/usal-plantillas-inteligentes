# Secretos de las Edge Functions de Supabase (función `assistant`).
# NO se commitea ningún valor real. Cargar con:
#   supabase secrets set --env-file supabase/functions/.env   (archivo local, fuera de git)
# o uno por uno:  supabase secrets set NOMBRE=valor
# o desde el panel: Project Settings → Edge Functions → Secrets.

# Clave del proveedor compatible con OpenAI (OpenRouter: empieza con sk-or-). Obligatoria para el modo nube.
ASSISTANT_API_KEY=
# URL base de la API. Por defecto: https://openrouter.ai/api/v1
ASSISTANT_BASE_URL=
# Modelo. Por defecto: qwen/qwen3-14b
ASSISTANT_MODEL=
# Consultas por hora por usuario. Por defecto: 30
ASSISTANT_HOURLY_LIMIT=
# Encabezados opcionales de atribución para OpenRouter (HTTP-Referer y X-Title).
ASSISTANT_REFERER=
ASSISTANT_TITLE=

# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase
# automáticamente en cada función: no se cargan ni se escriben acá.
